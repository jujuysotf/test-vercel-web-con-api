# Mismo OAuth Web Client ID que el salón.
# En Google Cloud, el origen de JavaScript tiene que incluir la URL de este proyecto.
VITE_GOOGLE_CLIENT_ID=

# Calendario. En local alcanza con google-credentials.json.
# En Vercel, pegá el JSON de la service account en una sola línea.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Alternativa al JSON completo.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
